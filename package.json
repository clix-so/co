{
  "name": "@clix-so/co",
  "version": "0.1.0",
  "description": "Goroutine-style co(...) execution API for Bun Workers",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun run build:js && bun run build:types",
    "build:js": "bun build ./src/index.ts --outdir ./dist --target bun --format esm",
    "build:types": "tsc --emitDeclarationOnly --outDir ./dist",
    "test": "bun test",
    "test:unit": "bun test test/",
    "test:e2e": "bun test e2e/",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "prepublishOnly": "bun run build && bun run test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.10",
    "@types/bun": "^1.3.5",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "bun": ">=1.0.0"
  },
  "keywords": [
    "bun",
    "workers",
    "goroutine",
    "concurrency",
    "parallel",
    "thread",
    "pool"
  ],
  "author": "clix-so",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/clix-so/co.git"
  },
  "engines": {
    "bun": ">=1.0.0"
  }
}
